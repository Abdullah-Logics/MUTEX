{
  "name": "mutex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev dist --port 8787",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 execute mutex-db --remote --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute mutex-db --local --file=migrations/0001_init.sql",
    "d1:create": "wrangler d1 create mutex-db",
    "r2:create": "wrangler r2 bucket create mutex-files",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "framer-motion": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.6",
    "vite": "^6.0.7",
    "wrangler": "^4.113.0"
  }
}
